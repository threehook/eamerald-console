# Local/dev image for the eamerald-console Helm chart (k8s/eamerald-console). Not published to a registry -
# build it with a fresh, unique tag every time (see k8s/eamerald-console/values.yaml) since Docker Desktop's
# Kubernetes caches images by tag separately from the Docker CLI's daemon-visible store.
FROM node:22-alpine AS build
WORKDIR /app

# native modules (tree-sitter, esbuild, swc) need a build toolchain on alpine/musl
RUN apk add --no-cache python3 make g++

COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
# not --immutable: the working tree's package.json/yarn.lock are mid-rebase on dependency bumps
# (peer-dependency warnings on react/vite versions), same as a local `yarn install` right now.
RUN yarn install

# VITE_* vars are inlined into the JS bundle at build time, read from the checked-in .env
# (https://localhost:8080, matching the eamerald-hub console gateway's LoadBalancer port on
# Docker Desktop). To point at a different backend, edit .env before building this image.
COPY . .
RUN yarn build

FROM nginx:1.27-alpine
COPY k8s/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
